[package]
name = "magic-server"
version = "1.0.0"
description = "MagicMirror HTTP Server"
edition = "2021"

[lib]
name = "magic_server"
path = "src/lib.rs"

[[bin]]
name = "magic-server"
path = "src/main.rs"

[dependencies]
axum = "0.8"
anyhow = "1"
tokio = { version = "1", features = ["full"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tower-http = { version = "0.6", features = ["cors"] }
tracing = "0.1"
tracing-subscriber = "0.3"
dirs = "5"
sys-info = "0.9"

# ONNX Runtime
ort = { version = "2.0.0-rc.13", features = ["directml"] }
# 可选：启用 CUDA 支持（NVIDIA GPU）
# ort = { version = "2.0.0-rc.13", features = ["cuda", "directml", "ondemand"] }

# Image processing
image = "0.25"
jpeg-encoder = "0.7"

# ndarray for tensor operations (must match ort's version)
ndarray = "0.17"

# Error handling
thiserror = "1"

[profile.release]
strip = true
lto = true
codegen-units = 1
panic = "abort"
